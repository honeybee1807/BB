# Copy to .env.local for local development. NEVER commit real values.
# Variables without NEXT_PUBLIC_ are server-only and must never reach the browser.

# Supabase (local stack values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Read ONLY in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Resend email (server-only)
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated recipients
INQUIRY_NOTIFY_TO=
SECURITY_ALERT_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=
# "true" to show availability on public property pages (default off)
NEXT_PUBLIC_SHOW_PUBLIC_AVAILABILITY=

# Shared secret sent by the keep-alive monitor in the x-health-token header (server-only)
HEALTH_TOKEN=
